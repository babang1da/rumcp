# Скопируйте в .env и поправьте под себя. Значения по умолчанию работают
# для локального `docker compose up` без .env.

# Postgres
POSTGRES_USER=rumcp
POSTGRES_PASSWORD=rumcp
POSTGRES_DB=rumcp

# Настройки сервиса на Go. DATABASE_URL внутри compose собирается из переменных
# Postgres выше; здесь он нужен для запуска сервиса вне compose (localhost).
LOG_LEVEL=info
DATABASE_URL=postgres://rumcp:rumcp@localhost:5432/rumcp?sslmode=disable

# Публичный адрес сервиса: из него собираются OAuth-метаданные и redirect_uri.
BASE_URL=http://localhost:8080

# Ключ AES-256 для токенов Яндекса в БД: 32 байта — base64, hex или 32 символа.
# Значение ниже только для локального запуска, в проде нужен свой.
TOKEN_ENCRYPTION_KEY=dev-only-token-encryption-key-32
# Ключ подписи cookie кабинета, минимум 16 символов.
SESSION_SECRET=dev-only-session-secret
# Вызовов MCP на пользователя в сутки.
DAILY_LIMIT=100

# Приложение Яндекс OAuth. Пока его нет (ZHC-877) — вход в dev по тестовому токену:
# работает только при пустом YANDEX_CLIENT_ID.
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_TEST_TOKEN=

# SEO и аналитика web: значения встраиваются в сборку web при `docker compose build`.
# Пустые — счётчик Метрики и тег подтверждения Вебмастера не рендерятся.
VITE_METRIKA_ID=
VITE_WEBMASTER_VERIFICATION=
